# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments — from Dashboard > Developer > API Keys / Webhooks.
# Milestone 4 uses Dodo instead of the Stripe named in BUILD_BRIEF.md (user
# decision — see README "Payments" section).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT=test_mode
NEXT_PUBLIC_DODO_PAYMENTS_ENVIRONMENT=test_mode

# Razorpay — no platform-level keys are needed. Each creator connects their
# own Razorpay account from Dashboard > Payments; the credentials are stored
# per-creator in Supabase Vault (migrations/0011) and read only by
# service_role at payment time. Buyers pay the creator directly, so the
# platform never holds funds and takes no per-sale cut.

# Paddle — sandbox. From Paddle Dashboard > Developer Tools. PADDLE_API_KEY
# is a server-only secret (scripts/ catalog setup, any webhook handler).
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN is safe client-side (Paddle.js requires it
# in the browser) — scoped to price preview/checkout only, never grants
# account-management access.
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Secret for one specific notification destination (Developer Tools >
# Notifications > your destination) — not the same value as PADDLE_API_KEY.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
# "sandbox" or "production" — required, never defaulted. The pricing page
# fails loudly at build/runtime if this is unset, rather than silently
# running against the wrong Paddle account.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Resend (transactional email)
RESEND_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /admin (payout tracking) — comma-separated email allowlist, not a real
# role system. Set to the platform operator's own login email(s).
ADMIN_EMAILS=

# Anthropic — optional. Powers AI title cleanup on import and the AI page
# designer (Links → Theme → "Design it with AI"). Without it, import still
# works with titles exactly as scraped, and the designer says it isn't on.
ANTHROPIC_API_KEY=
# Optional model overrides. The designer defaults to claude-opus-5.
# PAGE_THEME_MODEL=
# IMPORT_CLEANUP_MODEL=

# Vercel — optional. Custom domains (Dashboard → Domains) register each
# creator's domain on this Vercel project through the REST API. Create a
# token at vercel.com/account/tokens scoped to the team that owns the project.
# The project and team ids are in .vercel/project.json after `vercel link`.
# Without the token, the Domains page and the landing page say "not yet".
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
