# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments — from Dashboard > Developer > API Keys / Webhooks.
# Milestone 4 uses Dodo instead of the Stripe named in BUILD_BRIEF.md (user
# decision — see README "Payments" section).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT=test_mode
NEXT_PUBLIC_DODO_PAYMENTS_ENVIRONMENT=test_mode

# Razorpay — from Dashboard > Settings > API Keys. A second, working
# provider used while Dodo's account verification is pending; CheckoutModal
# prefers whichever of the two is configured, Razorpay first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Webhook secret for /api/webhooks/razorpay — you generate this value
# yourself (e.g. `openssl rand -hex 32`) and set it both here AND when you
# register the webhook (Dashboard > Settings > Webhooks, or POST
# /v1/webhooks / razorpay.webhooks.create()) — Razorpay rejects
# localhost/private-IP URLs at creation time, so this needs a public URL
# (tunnel or deployment) first. `events` in that request must be an object
# of {eventName: true}, e.g. {"payment.captured": true}, NOT an array of
# strings — the array shape shown in several third-party examples online
# is rejected with a misleading "could not be decoded" / "Invalid event
# name/names" error, confirmed empirically against the real API.
RAZORPAY_WEBHOOK_SECRET=

# Paddle — sandbox. From Paddle Dashboard > Developer Tools. PADDLE_API_KEY
# is a server-only secret (scripts/ catalog setup, any webhook handler).
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN is safe client-side (Paddle.js requires it
# in the browser) — scoped to price preview/checkout only, never grants
# account-management access.
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Secret for one specific notification destination (Developer Tools >
# Notifications > your destination) — not the same value as PADDLE_API_KEY.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
# "sandbox" or "production" — required, never defaulted. The pricing page
# fails loudly at build/runtime if this is unset, rather than silently
# running against the wrong Paddle account.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Resend (transactional email)
RESEND_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /admin (payout tracking) — comma-separated email allowlist, not a real
# role system. Set to the platform operator's own login email(s).
ADMIN_EMAILS=

# Anthropic — optional. Powers AI title cleanup on import (Milestone 3).
# Without it, import still works; titles arrive exactly as scraped.
ANTHROPIC_API_KEY=
